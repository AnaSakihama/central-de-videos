    {
      "parameters": {
        "jsCode": "function sanitize(val) {\n  if (val === null || val === undefined) return 'NULL';\n  return \"'\" + String(val).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"''\") + \"'\";\n}\nconst payment = $input.first().json;\nconst meta = payment.metadata || {};\nconst payer = payment.payer || {};\nconst name = payer.first_name ? `${payer.first_name} ${payer.last_name || ''}`.trim() : (meta.name || 'Cliente');\nconst status = payment.status || 'pending';\nconst isApproved = status === 'approved';\nconst email = (\n  meta.email ||\n  payer.email ||\n  (payment.additional_info && payment.additional_info.payer && payment.additional_info.payer.email) ||\n  ''\n).toString().trim();\nlet inviteCode = null;\nif (isApproved) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  inviteCode = 'SV-';\n  for (let i = 0; i < 6; i++) { inviteCode += chars.charAt(Math.floor(Math.random() * chars.length)); }\n}\nconst orderId = payment.id?.toString() || '';\nconst price = Number(payment.transaction_amount || 0);\nconst paymentStatus = isApproved ? 'aprovado' : 'pendente';\nconst orderStatus = 'novo';\nconst createdAt = payment.date_created || new Date().toISOString();\nconst insert_sql = `INSERT INTO core.orders (order_id, name, email, price, payment_status, invite_code, created_at, order_status, log_email) VALUES (${sanitize(orderId)}, ${sanitize(name)}, ${sanitize(email)}, ${price}, ${sanitize(paymentStatus)}, ${inviteCode ? sanitize(inviteCode) : 'NULL'}, ${sanitize(createdAt)}, ${sanitize(orderStatus)}, '') ON CONFLICT (order_id) DO UPDATE SET payment_status = EXCLUDED.payment_status, invite_code = COALESCE(NULLIF(core.orders.invite_code, 'null'), EXCLUDED.invite_code), order_status = COALESCE(core.orders.order_status, EXCLUDED.order_status)`;\nreturn [{ json: { order_id: orderId, payment_id: orderId, name: name.toString(), email, price, payment_status: paymentStatus, order_status: orderStatus, invite_code: inviteCode, created_at: createdAt, approved_at: isApproved ? payment.date_approved : null, insert_sql } }];"
      },
