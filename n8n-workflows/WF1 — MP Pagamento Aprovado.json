    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.orders (\n  order_id, name, email, price, payment_status, invite_code, created_at, order_status, log_email\n) VALUES (\n  '{{$json.order_id}}', \n  '{{$json.name}}', \n  '{{$json.email}}', \n  {{$json.price}}, \n  '{{$json.payment_status}}', \n  NULLIF('{{$json.invite_code}}', 'null'), \n  '{{$json.created_at}}', \n  '{{$json.order_status}}', \n  ''\n) \nON CONFLICT (order_id) \nDO UPDATE SET \n  payment_status = EXCLUDED.payment_status,\n  invite_code = COALESCE(NULLIF(core.orders.invite_code, 'null'), EXCLUDED.invite_code),\n  order_status = COALESCE(core.orders.order_status, EXCLUDED.order_status);",
