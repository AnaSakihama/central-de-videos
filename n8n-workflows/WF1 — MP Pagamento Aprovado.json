    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst raw = $json || {};\nconst body = raw.body || raw;\nconst headers = raw.headers || {};\n\n// C4 — Valida assinatura HMAC-SHA256 do Mercado Pago (nao-bloqueante)\nconst secret = $env.MP_WEBHOOK_SECRET || '';\nconst xSignature = headers['x-signature'] || '';\nconst xRequestId = headers['x-request-id'] || '';\nlet signatureValid = true;\nif (secret && xSignature && secret.length > 5) {\n  const sigParts = {};\n  xSignature.split(',').forEach(p => { const [k,v] = p.split('='); sigParts[k.trim()] = (v||'').trim(); });\n  const ts = sigParts['ts'] || '';\n  const v1 = sigParts['v1'] || '';\n  const dataId = body?.data?.id ? String(body.data.id)\n    : body?.id ? String(body.id) : '';\n  const manifest = `id:${dataId};request-id:${xRequestId};ts:${ts};`;\n  const hmac = crypto.createHmac('sha256', secret).update(manifest).digest('hex');\n  signatureValid = (hmac === v1);\n  // Loga para debug mas nao bloqueia - ativar bloqueio apos confirmar assinatura correta\n  if (!signatureValid) console.warn('MP signature mismatch:', { manifest, expected: v1, got: hmac });\n}\n\nconst eventType = body?.type || body?.topic || '';\nlet resourceId = '';\nif (body?.data?.id) {\n  resourceId = String(body.data.id);\n} else if (body?.id) {\n  resourceId = String(body.id);\n} else if (body?.resource && typeof body.resource === 'string') {\n  const parts = body.resource.split('/');\n  resourceId = parts[parts.length - 1];\n}\nreturn [{ json: { body, headers, event_type: eventType, resource_id: resourceId, received_at: new Date().toISOString(), signature_valid: signatureValid } }];"
      },
