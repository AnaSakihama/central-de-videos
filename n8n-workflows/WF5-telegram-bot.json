{
  "name": "WF5 — Telegram Bot (Libera Acesso)",
  "nodes": [
    {
      "id": "node-webhook-tg",
      "name": "Webhook Telegram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-bot",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "node-extract-code",
      "name": "Extrair Código /start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || {};\nconst msg = body.message || $input.first().json.message || {};\nconst text = msg.text || '';\nconst chatId = msg.chat?.id || body.message?.chat?.id || null;\nconst firstName = msg.from?.first_name || 'Usuário';\n\nlet code = null;\nif (text) {\n  // Regex robusta para capturar o código após /start\n  const match = text.match(/\\/start\\s+([A-Z0-9\\-]+)/i);\n  if (match && match[1]) {\n    code = match[1].trim().toUpperCase();\n  }\n}\n\nreturn [{ json: { code, chat_id: chatId, first_name: firstName, raw_text: text } }];"
      }
    },
    {
      "id": "node-check-code",
      "name": "Tem código?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "id": "cond-code", "leftValue": "={{ $json.code }}", "operator": { "type": "string", "operation": "notEmpty" } }]
        }
      }
    },
    {
      "id": "node-pg-lookup",
      "name": "Validar Código no DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [910, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT order_id, name, email FROM core.orders WHERE invite_code = '{{ $json.code }}' AND code_used_at IS NULL LIMIT 1;"
      },
      "credentials": {
        "postgres": { "id": "PPEXcNJ5kjQ8UbuR", "name": "PostgresSellingVideos" }
      }
    },
    {
      "id": "node-check-valid",
      "name": "Código Válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1130, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "id": "cond-valid", "leftValue": "={{ $json.order_id }}", "operator": { "type": "string", "operation": "notEmpty" } }]
        }
      }
    },
    {
      "id": "node-tg-generate-link",
      "name": "Gerar Link Temporário",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1350, 150],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8621371115:AAH26uR8zSLzaaYFpofhc5NuJ23Yg4Ss83E/createChatInviteLink",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "-1003846840774" },
            { "name": "member_limit", "value": 1 },
            { "name": "expire_date", "value": "={{ Math.floor(Date.now()/1000) + 43200 }}" }
          ]
        }
      }
    },
    {
      "id": "node-tg-send-link",
      "name": "Enviar Link ao Usuário",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1570, 150],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8621371115:AAH26uR8zSLzaaYFpofhc5NuJ23Yg4Ss83E/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $('Extrair Código /start').item.json.chat_id }}" },
            { "name": "text", "value": "=✅ Olá {{ $('Extrair Código /start').item.json.first_name }}! Seu acesso VIP foi validado.\n\nClique no link abaixo para entrar no canal:\n{{ $json.result.invite_link }}\n\n⚠️ Este link expira em 5 minutos e só pode ser usado uma vez." },
            { "name": "parse_mode", "value": "HTML" }
          ]
        }
      }
    },
    {
      "id": "node-pg-mark-used",
      "name": "Marcar como Usado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1790, 150],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE core.orders SET code_used_at = NOW(), payment_status = 'aprovado_no_telegram' WHERE invite_code = '{{ $('Extrair Código /start').item.json.code }}';"
      },
      "credentials": {
        "postgres": { "id": "PPEXcNJ5kjQ8UbuR", "name": "PostgresSellingVideos" }
      }
    },
    {
      "id": "node-tg-invalid-code",
      "name": "Erro - Código Inválido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1350, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8621371115:AAH26uR8zSLzaaYFpofhc5NuJ23Yg4Ss83E/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $node['Extrair Código /start'].json.chat_id }}" },
            { "name": "text", "value": "❌ <b>Código Inválido ou Já Utilizado.</b>\n\nPor favor, verifique se você copiou o código corretamente do seu e-mail de acesso. Se o problema persistir, entre em contato com o suporte." },
            { "name": "parse_mode", "value": "HTML" }
          ]
        }
      }
    },
    {
      "id": "node-tg-no-code",
      "name": "Erro - Sem Código",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [910, 420],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8621371115:AAH26uR8zSLzaaYFpofhc5NuJ23Yg4Ss83E/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $json.chat_id }}" },
            { "name": "text", "value": "👋 Olá! Este bot é utilizado para liberar acesso VIP ao SellingVideos.\n\nSe você já adquiriu seu acesso, clique no link enviado no seu e-mail.\n\nSe ainda não adquiriu, acesse: https://saleschannel.com.br/sellingvideos" },
            { "name": "parse_mode", "value": "HTML" }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Telegram": { "main": [[{ "node": "Extrair Código /start", "type": "main", "index": 0 }]] },
    "Extrair Código /start": { "main": [[{ "node": "Tem código?", "type": "main", "index": 0 }]] },
    "Tem código?": {
      "main": [
        [{ "node": "Validar Código no DB", "type": "main", "index": 0 }],
        [{ "node": "Erro - Sem Código", "type": "main", "index": 0 }]
      ]
    },
    "Validar Código no DB": { "main": [[{ "node": "Código Válido?", "type": "main", "index": 0 }]] },
    "Código Válido?": {
      "main": [
        [{ "node": "Gerar Link Temporário", "type": "main", "index": 0 }],
        [{ "node": "Erro - Código Inválido", "type": "main", "index": 0 }]
      ]
    },
    "Gerar Link Temporário": { "main": [[{ "node": "Enviar Link ao Usuário", "type": "main", "index": 0 }]] },
    "Enviar Link ao Usuário": { "main": [[{ "node": "Marcar como Usado", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["sellingvideos"]
}
