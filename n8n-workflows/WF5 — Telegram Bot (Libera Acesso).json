    {
      "parameters": {
        "jsCode": "const payload = $input.first().json || {};\nconst body = payload.body || {};\nconst msg = body.message || body.edited_message || payload.message || null;\n\nif (!msg || !msg.chat?.id) {\n  return [];\n}\n\nconst chatId = msg.chat.id;\nconst userId = msg.from?.id || null;\nconst chatType = msg.chat?.type || null;\nconst firstName = msg.from?.first_name || 'Usuário';\nconst text = (msg.text || msg.caption || '').trim();\n\n// Processa apenas conversa privada com o bot\nif (chatType !== 'private') {\n  return [];\n}\n\nlet code = null;\nconst match = text.match(/^\\/start(?:@\\w+)?(?:\\s+([A-Z0-9\\-_]+))?$/i);\nif (match && match[1]) {\n  code = match[1].trim().toUpperCase();\n}\n\nreturn [{\n  json: {\n    code,\n    chat_id: chatId,\n    user_id: userId,\n    chat_type: chatType,\n    first_name: firstName,\n    raw_text: text\n  }\n}];"
      },
      "id": "a9cf3398-65a5-4c1d-8ebb-e1a2e92207b3",
      "name": "Extrair Código /start",
      "type": "n8n-nodes-base.code",
