    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst msg = body.message || $input.first().json.message || {};\n\n// Ignorar eventos que nao sao mensagens de texto (left_chat_member, new_chat_member, etc.)\nif (!msg.text || !msg.chat?.id) {\n  return [];\n}\n\nconst text = msg.text || '';\nconst chatId = msg.chat?.id || null;\nconst userId = msg.from?.id || null;\nconst chatType = msg.chat?.type || null;\nconst firstName = msg.from?.first_name || 'Usuário';\n\nlet code = null;\nconst match = text.match(/\\/start\\s+([A-Z0-9\\-]+)/i);\nif (match && match[1]) {\n  code = match[1].trim().toUpperCase();\n}\n\nreturn [{\n  json: {\n    code,\n    chat_id: chatId,\n    user_id: userId,\n    chat_type: chatType,\n    first_name: firstName,\n    raw_text: text\n  }\n}];"
      },
