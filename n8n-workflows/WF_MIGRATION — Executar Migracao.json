      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS core.webhook_logs (\n  order_id     TEXT        NOT NULL,\n  event_type   TEXT,\n  action_taken TEXT        NOT NULL,\n  created_at   TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP\n);",
        "options": {}
      },
      "id": "run-migration-1",
      "name": "1. Criar Tabela se não existir",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        280,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "JAKg7UeoJtM66d5M",
          "name": "PostgresEstudiodemidias"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM core.webhook_logs a\nUSING core.webhook_logs b\nWHERE a.ctid < b.ctid\n  AND a.order_id = b.order_id\n  AND a.action_taken = b.action_taken;",
        "options": {}
      },
      "id": "run-migration-2",
      "name": "2. Limpar registros duplicados",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
