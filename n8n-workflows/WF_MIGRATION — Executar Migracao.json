        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "JAKg7UeoJtM66d5M",
          "name": "PostgresEstudiodemidias"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE UNIQUE INDEX IF NOT EXISTS unique_order_action_idx ON core.webhook_logs (order_id, action_taken);",
        "options": {}
      },
      "id": "run-migration-3",
      "name": "3. Criar Indice de Unicidade",
