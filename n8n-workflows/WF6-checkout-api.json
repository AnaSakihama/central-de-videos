{
  "name": "WF6 — Checkout API (sellingvideos)",
  "nodes": [
    {
      "id": "node-webhook-checkout",
      "name": "Webhook Checkout",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "checkout",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "node-check-active-buy",
      "name": "Verificar Compra Ativa",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT order_id FROM core.orders WHERE email = '{{ $node[\"Webhook Checkout\"].json.query?.email }}' AND payment_status = 'aprovado' LIMIT 1;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "PPEXcNJ5kjQ8UbuR",
          "name": "PostgresSalesChannel"
        }
      }
    },
    {
      "id": "node-if-already-vip",
      "name": "Já é VIP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-order",
              "leftValue": "={{ $json.order_id }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-respond-already-vip",
      "name": "Resposta - Cliente Já Ativo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        910,
        200
      ],
      "parameters": {
        "options": {
          "responseCode": 200,
          "responseData": "={\n  \"status\": \"already_purchased\",\n  \"message\": \"Identificamos que este e-mail já possui uma compra com pagamento confirmado. Para reestabelecer seu acesso, utilize o formulário de suporte.\"\n}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    },
    {
      "id": "node-mp-preference",
      "name": "Criar Preferência MP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        910,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.mercadopago.com/checkout/preferences",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"items\": [\n    {\n      \"title\": \"Acesso Vitalício SellingVideos VIP\",\n      \"unit_price\": 12.90,\n      \"quantity\": 1,\n      \"currency_id\": \"BRL\"\n    }\n  ],\n  \"payer\": {\n    \"email\": \"{{ $node[\\\"Webhook Checkout\\\"].json.query?.email || 'comprador@teste.com' }}\"\n  },\n  \"back_urls\": {\n    \"success\": \"https://saleschannel.com.br/sellingvideos/obrigado.html\",\n    \"failure\": \"https://saleschannel.com.br/sellingvideos/index.html\",\n    \"pending\": \"https://saleschannel.com.br/sellingvideos/obrigado.html\"\n  },\n  \"auto_return\": \"approved\",\n  \"notification_url\": \"https://n8n.saleschannel.com.br/webhook/mp-payment\",\n  \"statement_descriptor\": \"SELLINGVIDEOS\",\n  \"external_reference\": \"CHECKOUT_DYNAMIC\",\n  \"metadata\": {\n    \"email\": \"{{ $node[\\\"Webhook Checkout\\\"].json.query?.email }}\"\n  },\n  \"payment_methods\": {\n    \"excluded_payment_types\": [\n      { \"id\": \"ticket\" },\n      { \"id\": \"atm\" }\n    ],\n    \"installments\": 12\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Mercado Pago - Access Token"
        }
      }
    },
    {
      "id": "node-respond-checkout",
      "name": "Resposta - URL Checkout",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1130,
        400
      ],
      "parameters": {
        "options": {
          "responseCode": 200,
          "responseData": "={\n  \"status\": \"success\",\n  \"url\": \"{{ $json.init_point }}\",\n  \"id\": \"{{ $json.id }}\"\n}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook Checkout": {
      "main": [
        [
          {
            "node": "Verificar Compra Ativa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar Compra Ativa": {
      "main": [
        [
          {
            "node": "Já é VIP?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Já é VIP?": {
      "main": [
        [
          {
            "node": "Resposta - Cliente Já Ativo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Criar Preferência MP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Criar Preferência MP": {
      "main": [
        [
          {
            "node": "Resposta - URL Checkout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
