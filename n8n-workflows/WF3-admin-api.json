{
  "name": "WF3 — Admin API (Nova Versão)",
  "nodes": [
    {
      "id": "node-webhook-admin",
      "name": "Webhook Admin",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "admin",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "node-check-auth",
      "name": "Verificar Admin Key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        470,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-auth",
              "leftValue": "={{ $json.headers['x-admin-key'] }}",
              "rightValue": "DEFINA_SUA_ADMIN_KEY_AQUI",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-is-list-route",
      "name": "É Listagem?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        690,
        250
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-list",
              "leftValue": "={{ $json.body?.action || 'listar_pedidos' }}",
              "rightValue": "listar_pedidos",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-respond-unauthorized",
      "name": "Resposta - Não Autorizado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        690,
        450
      ],
      "parameters": {
        "options": {
          "responseCode": 401,
          "responseData": "{\"error\":\"Unauthorized\"}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      }
    },
    {
      "id": "node-code-build-query",
      "name": "Montar Query de Listagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0) return [];\nconst body = items[0].json.body || {};\nconst query = items[0].json.query || {};\nconst search = (query.search || body.search || '').toString().toLowerCase();\nconst paymentStatus = (query.payment_status || body.payment_status || '').toString().toLowerCase();\nconst orderStatus = (query.order_status || body.order_status || '').toString().toLowerCase();\nconst conditions = [];\nconst params = [];\nif (search) {\n  params.push(`%${search}%`);\n  const p = params.length;\n  conditions.push(`(LOWER(email) LIKE $${p} OR LOWER(telegram_username) LIKE $${p} OR LOWER(name) LIKE $${p})`);\n}\nif (paymentStatus) {\n  params.push(paymentStatus);\n  conditions.push(`LOWER(payment_status) = $${params.length}`);\n}\nif (orderStatus) {\n  params.push(orderStatus);\n  conditions.push(`LOWER(order_status) = $${params.length}`);\n}\nconst where = conditions.length ? 'WHERE ' + conditions.join(' AND ') : '';\nconst sql = `SELECT * FROM core.orders ${where} ORDER BY created_at DESC`;\nreturn [{ json: { sql, params } }];"
      }
    },
    {
      "id": "node-pg-list",
      "name": "Consultar Pedidos PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        1130,
        180
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": {
          "id": "PPEXcNJ5kjQ8UbuR",
          "name": "PostgresSellingVideos"
        }
      }
    },
    {
      "id": "node-serialize-response",
      "name": "Serializar Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1350,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const orders = $input.all().map(i => i.json);\nreturn [{ json: { orders, total: orders.length } }];"
      }
    },
    {
      "id": "node-respond-list",
      "name": "Resposta - Lista de Pedidos",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1570,
        180
      ],
      "parameters": {
        "options": {
          "responseCode": 200,
          "responseData": "={{ JSON.stringify($json) }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    },
    {
      "id": "node-pg-update-status",
      "name": "Atualizar Status no PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        910,
        340
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE core.orders\nSET\n  order_status = '{{ $(\"Webhook Admin\").item.json.body.order_status }}',\n  approved_at = CASE\n    WHEN '{{ $(\"Webhook Admin\").item.json.body.approved_at }}' <> ''\n    THEN '{{ $(\"Webhook Admin\").item.json.body.approved_at }}'::TIMESTAMPTZ\n    ELSE approved_at\n  END\nWHERE order_id = '{{ $(\"Webhook Admin\").item.json.body.order_id }}';"
      },
      "credentials": {
        "postgres": {
          "id": "PPEXcNJ5kjQ8UbuR",
          "name": "PostgresSellingVideos"
        }
      }
    },
    {
      "id": "node-respond-update-success",
      "name": "Resposta - Status Atualizado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1130,
        340
      ],
      "parameters": {
        "options": {
          "responseCode": 200,
          "responseData": "{\"success\":true,\"message\":\"Status atualizado com sucesso\"}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    }
  ],
