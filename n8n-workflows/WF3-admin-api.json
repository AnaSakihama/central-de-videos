        {
            "id": "node-code-filter",
            "name": "Filtrar e Serializar Pedidos",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1130,
                180
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "// Pega parâmetros do request original\nconst body = $('Webhook Admin').first().json.body || {};\nconst query = $('Webhook Admin').first().json.query || {};\nconst search = (query.search || body.search || '').toLowerCase();\nconst statusPagamento = (query.status_pagamento || body.status_pagamento || '').toLowerCase();\nconst statusPedido = (query.status_pedido || body.status_pedido || '').toLowerCase();\n\n// Todos os pedidos vindos do Sheets\nlet orders = $input.all().map(i => i.json);\n\n// Aplicar filtros\nif (search) {\n  orders = orders.filter(o =>\n    (o.email || '').toLowerCase().includes(search) ||\n    (o.telegram_username || '').toLowerCase().includes(search) ||\n    (o.nome || '').toLowerCase().includes(search)\n  );\n}\nif (statusPagamento) {\n  orders = orders.filter(o => (o.status_pagamento || '').toLowerCase() === statusPagamento);\n}\nif (statusPedido) {\n  orders = orders.filter(o => (o.status_pedido || '').toLowerCase() === statusPedido);\n}\n\n// Ordenar por data de criação (mais recente primeiro)\norders.sort((a, b) => new Date(b.criado_em || 0) - new Date(a.criado_em || 0));\n\nreturn [{ json: { orders, total: orders.length } }];"
            }
        },
