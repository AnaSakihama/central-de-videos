{
  "name": "WF1 — MP Pagamento Aprovado (V3)",
  "nodes": [
    {
      "id": "node-webhook",
      "name": "Receber IPN Mercado Pago",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "mp-payment-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "mp-payment",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "node-route-ipn",
      "name": "Roteador de Notificação",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [320, 300],
      "parameters": {
        "mode": "expression",
        "output": "single",
        "rules": {
          "rules": [
            {
              "outputKey": "payment",
              "value2": "payment",
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "id": "c1", "leftValue": "={{ $json.type || $json.topic }}", "rightValue": "payment", "operator": { "type": "string", "operation": "equals" } }
                ]
              }
            },
            {
              "outputKey": "merchant_order",
              "value2": "merchant_order",
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "id": "c2", "leftValue": "={{ $json.type || $json.topic }}", "rightValue": "merchant_order", "operator": { "type": "string", "operation": "equals" } }
                ]
              }
            }
          ]
        },
        "fallbackOutput": "none"
      }
    },
    {
      "id": "node-fetch-order",
      "name": "Consultar Merchant Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [540, 420],
      "parameters": {
        "method": "GET",
        "url": "=https://api.mercadopago.com/merchant_orders/{{ $json.data?.id || $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}" }
          ]
        }
      },
      "credentials": { "httpHeaderAuth": { "id": "1", "name": "Mercado Pago - Access Token" } }
    },
    {
      "id": "node-extract-payment-id",
      "name": "Extrair ID do Pagamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 420],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const order = $input.first().json;\nconst payments = order.payments || [];\n\n// Busca o último pagamento ou o aprovado\nconst approved = payments.find(p => p.status === 'approved');\nconst latest = payments[payments.length - 1];\n\nconst paymentId = (approved ? approved.id : (latest ? latest.id : null));\n\nif (!paymentId) {\n  throw new Error('Nenhum pagamento encontrado para este pedido.');\n}\n\nreturn [{ json: { payment_id: paymentId.toString() } }];"
      }
    },
    {
      "id": "node-http-mp-v3",
      "name": "Consultar Pagamento MP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [980, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.mercadopago.com/v1/payments/{{ $json.payment_id || $node['Receber IPN Mercado Pago'].json.data?.id || $node['Receber IPN Mercado Pago'].json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}" }
          ]
        }
      },
      "credentials": { "httpHeaderAuth": { "id": "1", "name": "Mercado Pago - Access Token" } }
    },
    {
      "id": "node-switch-status",
      "name": "Detectar Status Pagamento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1200, 300],
      "parameters": {
        "mode": "expression",
        "output": "single",
        "rules": {
          "rules": [
            {
              "outputKey": "aprovado",
              "value2": "approved",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "id": "cond-app", "leftValue": "={{ $json.status }}", "rightValue": "approved", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "outputKey": "pendente",
              "value2": "pending",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "id": "cond-pen", "leftValue": "={{ $json.status }}", "rightValue": "pending", "operator": { "type": "string", "operation": "equals" } },
                  { "id": "cond-inp", "leftValue": "={{ $json.status }}", "rightValue": "in_process", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "or"
              }
            }
          ]
        },
        "fallbackOutput": "single",
        "fallbackOutputKey": "rejeitado"
      }
    },
    {
      "id": "node-build-order",
      "name": "Montar Objeto do Pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1470, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payment = $input.first().json;\nconst meta = payment.metadata || {};\nconst payer = payment.payer || {};\n\nconst name = payer.first_name\n  ? `${payer.first_name} ${payer.last_name || ''}`.trim()\n  : (meta.name || meta.nome || 'Afiliado');\n\nconst status = payment.status;\nconst isApproved = status === 'approved';\n\n// Geração de código único SV-XXXXXX se aprovado\nlet inviteCode = null;\nif (isApproved) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  inviteCode = 'SV-';\n  for (let i = 0; i < 6; i++) {\n    inviteCode += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n}\n\nreturn [{\n  json: {\n    order_id: payment.id?.toString() || String(Date.now()),\n    name: name,\n    email: payer.email || meta.email || '',\n    telegram_username: meta.telegram_username || '',\n    price: payment.transaction_amount?.toFixed(2) || '12.90',\n    payment_status: isApproved ? 'aprovado' : 'pendente',\n    order_status: isApproved ? 'novo' : 'aguardando_pagamento',\n    invite_code: inviteCode,\n    created_at: new Date().toISOString(),\n    approved_at: isApproved ? new Date().toISOString() : null,\n    log_email: ''\n  }\n}];"
      }
    },
    {
      "id": "node-pg-insert",
      "name": "Gravar Pedido no PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1690, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.orders\n  (order_id, name, email, telegram_username, price, payment_status, order_status, invite_code, created_at, approved_at, log_email)\nVALUES\n  ('{{ $json.order_id }}', '{{ $json.name }}', '{{ $json.email }}', '{{ $json.telegram_username }}', {{ $json.price }}, '{{ $json.payment_status }}', '{{ $json.order_status }}', '{{ $json.invite_code }}', '{{ $json.created_at }}', {{ $json.approved_at ? \"'\" + $json.approved_at + \"'\" : 'NULL' }}, '')\nON CONFLICT (order_id) DO UPDATE SET\n  payment_status = EXCLUDED.payment_status,\n  order_status   = EXCLUDED.order_status,\n  invite_code    = COALESCE(EXCLUDED.invite_code, core.orders.invite_code),\n  approved_at    = EXCLUDED.approved_at;"
      },
      "credentials": { "postgres": { "id": "10", "name": "PostgreSQL - SalesChannel" } }
    },
    {
      "id": "node-if-status-email",
      "name": "Verificar Status para Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1910, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "id": "c-email", "leftValue": "={{ $json.payment_status }}", "rightValue": "aprovado", "operator": { "type": "string", "operation": "equals" } }
          ]
        }
      }
    },
    {
      "id": "node-email-buyer",
      "name": "Email Comprador - Acesso VIP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [2160, 100],
      "parameters": {
        "fromEmail": "COLE_SEU_EMAIL_AQUI@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "✅ Acesso Liberado — Vídeos SellingVideos VIP",
        "emailType": "html",
        "message": "=<div style=\"font-family:Inter,Arial,sans-serif;max-width:600px;margin:0 auto;background:#f4f4f8;padding:0\">...</div>"
      },
      "credentials": { "smtp": { "id": "3", "name": "Gmail SMTP - SalesChannel" } }
    },
    {
      "id": "node-email-pending",
      "name": "Email Comprador - Pedido Recebido",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [2160, 300],
      "parameters": {
        "fromEmail": "COLE_SEU_EMAIL_AQUI@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "⏳ Recebemos seu pedido — SellingVideos",
        "emailType": "html",
        "message": "=<div style=\"font-family:Inter,Arial,sans-serif;max-width:600px;margin:0 auto;background:#f4f4f8;padding:0\">...</div>"
      },
      "credentials": { "smtp": { "id": "3", "name": "Gmail SMTP - SalesChannel" } }
    }
  ],
  "connections": {
    "Receber IPN Mercado Pago": { "main": [[{ "node": "Roteador de Notificação", "type": "main", "index": 0 }]] },
    "Roteador de Notificação": {
      "main": [
        [{ "node": "Consultar Pagamento MP", "type": "main", "index": 0 }],
        [{ "node": "Consultar Merchant Order", "type": "main", "index": 0 }]
      ]
    },
    "Consultar Merchant Order": { "main": [[{ "node": "Extrair ID do Pagamento", "type": "main", "index": 0 }]] },
    "Extrair ID do Pagamento": { "main": [[{ "node": "Consultar Pagamento MP", "type": "main", "index": 0 }]] },
    "Consultar Pagamento MP": { "main": [[{ "node": "Detectar Status Pagamento", "type": "main", "index": 0 }]] },
    "Detectar Status Pagamento": {
      "main": [
        [{ "node": "Montar Objeto do Pedido", "type": "main", "index": 0 }],
        [{ "node": "Montar Objeto do Pedido", "type": "main", "index": 0 }]
      ]
    },
    "Montar Objeto do Pedido": { "main": [[{ "node": "Gravar Pedido no PostgreSQL", "type": "main", "index": 0 }]] },
    "Gravar Pedido no PostgreSQL": { "main": [[{ "node": "Verificar Status para Email", "type": "main", "index": 0 }]] },
    "Verificar Status para Email": {
      "main": [
        [{ "node": "Email Comprador - Acesso VIP", "type": "main", "index": 0 }],
        [{ "node": "Email Comprador - Pedido Recebido", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["sellingvideos"]
}