    {
      "parameters": {
        "jsCode": "const payment = $input.first().json;\nconst meta = payment.metadata || {};\nconst payer = payment.payer || {};\nconst name = payer.first_name ? `${payer.first_name} ${payer.last_name || ''}`.trim() : (meta.name || 'Cliente');\nconst status = payment.status || 'pending';\nconst isApproved = status === 'approved';\nconst email = (meta.email || payer.email || '').toString().trim();\nlet inviteCode = null;\nif (isApproved) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  inviteCode = 'SV-';\n  for (let i = 0; i < 6; i++) { inviteCode += chars.charAt(Math.floor(Math.random() * chars.length)); }\n}\nreturn [{ json: { order_id: payment.id?.toString(), payment_id: payment.id?.toString(), name: name.toString(), email, price: Number(payment.transaction_amount || 0), payment_status: isApproved ? 'aprovado' : 'pendente', invite_code: inviteCode, created_at: payment.date_created, approved_at: isApproved ? payment.date_approved : null } }];"
      },
