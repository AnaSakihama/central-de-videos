      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.orders\n  (order_id, name, email, telegram_username, price, payment_status, order_status, invite_code, created_at, approved_at, log_email)\nVALUES\n  (\n    '{{ ($json.order_id || \"\").replace(/'/g, \"''\") }}',\n    '{{ ($json.name || \"\").replace(/'/g, \"''\") }}',\n    '{{ ($json.email || \"\").replace(/'/g, \"''\") }}',\n    '{{ ($json.telegram_username || \"\").replace(/'/g, \"''\") }}',\n    {{ $json.price || 0 }},\n    '{{ ($json.payment_status || \"\").replace(/'/g, \"''\") }}',\n    '{{ ($json.order_status || \"\").replace(/'/g, \"''\") }}',\n    {{ $json.invite_code ? \"'\" + $json.invite_code.replace(/'/g, \"''\") + \"'\" : 'NULL' }},\n    '{{ $json.created_at }}',\n    {{ $json.approved_at ? \"'\" + $json.approved_at + \"'\" : 'NULL' }},\n    '{{ ($json.log_email || \"\").replace(/'/g, \"''\") }}'\n  )\nON CONFLICT (order_id) DO UPDATE SET\n  name = EXCLUDED.name,\n  email = EXCLUDED.email,\n  telegram_username = EXCLUDED.telegram_username,\n  price = EXCLUDED.price,\n  payment_status = EXCLUDED.payment_status,\n  order_status = EXCLUDED.order_status,\n  invite_code = COALESCE(core.orders.invite_code, EXCLUDED.invite_code),\n  approved_at = COALESCE(core.orders.approved_at, EXCLUDED.approved_at);",
        "options": {}
      },
