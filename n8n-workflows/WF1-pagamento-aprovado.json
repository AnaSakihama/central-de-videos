      "parameters": {
        "jsCode": "const merchantOrder = $input.first().json || {};\nconst payments = Array.isArray(merchantOrder.payments) ? merchantOrder.payments : [];\nconst approvedPayment = payments.find(p => p.status === 'approved');\nconst preferredPayment = approvedPayment || payments[payments.length - 1] || {};\nconst paymentId = preferredPayment.id ? String(preferredPayment.id) : '';\nreturn [{ json: { merchant_order_id: String(merchantOrder.id || ''), payment_id: paymentId, has_payment: !!paymentId } }];"
      },
