      "parameters": {
        "jsCode": "const raw = $json || {};\nconst body = raw.body || raw;\nconst headers = raw.headers || {};\n\nconst eventType = body?.type || body?.topic || '';\n\n// Extração robusta de ID (Suporta V2 (data.id), V1 (id) e IPN (resource URL))\nlet resourceId = '';\nif (body?.data?.id) {\n  resourceId = String(body.data.id);\n} else if (body?.id) {\n  resourceId = String(body.id);\n} else if (body?.resource && typeof body.resource === 'string') {\n  const parts = body.resource.split('/');\n  resourceId = parts[parts.length - 1];\n}\n\nreturn [{\n  json: {\n    body,\n    headers,\n    event_type: eventType,\n    resource_id: resourceId,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
