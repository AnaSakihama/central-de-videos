      "parameters": {
        "jsCode": "const merchantOrder = $input.first().json || {};\nconst payments = Array.isArray(merchantOrder.payments) ? merchantOrder.payments : [];\n\n// Prioriza pagamento aprovado, senão pega o último gerado\nconst approvedPayment = payments.find(p => p.status === 'approved');\nconst preferredPayment = approvedPayment || payments[payments.length - 1] || {};\n\nconst paymentId = preferredPayment.id ? String(preferredPayment.id) : '';\n\nreturn [{\n  json: {\n    merchant_order_id: String(merchantOrder.id || ''),\n    payment_id: paymentId,\n    has_payment: !!paymentId\n  }\n}];"
      },
