{
  "name": "WF1 — MP Pagamento Aprovado",
  "nodes": [
    {
      "id": "node-webhook",
      "name": "Receber IPN Mercado Pago",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "mp-payment-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "mp-payment",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "node-filter-type",
      "name": "Filtrar por Pagamento",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [410, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-is-payment",
              "leftValue": "={{ $json.type }}",
              "rightValue": "payment",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-http-mp",
      "name": "Consultar Pagamento MP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.mercadopago.com/v1/payments/{{ $json.data.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Mercado Pago - Access Token"
        }
      }
    },
    {
      "id": "node-switch-status",
      "name": "Detectar Status Pagamento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 300],
      "parameters": {
        "mode": "expression",
        "output": "single",
        "rules": {
          "rules": [
            {
              "outputKey": "aprovado",
              "value2": "approved",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "id": "cond-app", "leftValue": "={{ $json.status }}", "rightValue": "approved", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "outputKey": "pendente",
              "value2": "pending",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  { "id": "cond-pen", "leftValue": "={{ $json.status }}", "rightValue": "pending", "operator": { "type": "string", "operation": "equals" } },
                  { "id": "cond-inp", "leftValue": "={{ $json.status }}", "rightValue": "in_process", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "or"
              }
            }
          ]
        },
        "fallbackOutput": "single",
        "fallbackOutputKey": "rejeitado"
      }
    },
    {
      "id": "node-build-order",
      "name": "Montar Objeto do Pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payment = $input.first().json;\nconst meta = payment.metadata || {};\nconst payer = payment.payer || {};\n\nconst name = payer.first_name\n  ? `${payer.first_name} ${payer.last_name || ''}`.trim()\n  : (meta.name || meta.nome || 'Afiliado');\n\nconst status = payment.status;\nconst isApproved = status === 'approved';\n\n// Geração de código único SV-XXXXXX se aprovado\nlet inviteCode = null;\nif (isApproved) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  inviteCode = 'SV-';\n  for (let i = 0; i < 6; i++) {\n    inviteCode += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n}\n\nreturn [{\n  json: {\n    order_id: payment.id?.toString() || String(Date.now()),\n    name: name,\n    email: payer.email || meta.email || '',\n    telegram_username: meta.telegram_username || '',\n    price: payment.transaction_amount?.toFixed(2) || '12.90',\n    payment_status: isApproved ? 'aprovado' : 'pendente',\n    order_status: isApproved ? 'novo' : 'aguardando_pagamento',\n    invite_code: inviteCode,\n    created_at: new Date().toISOString(),\n    approved_at: isApproved ? new Date().toISOString() : null,\n    log_email: ''\n  }\n}];"
      }
    },
    {
      "id": "node-pg-insert",
      "name": "Gravar Pedido no PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1180, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.orders\n  (order_id, name, email, telegram_username, price, payment_status, order_status, invite_code, created_at, approved_at, log_email)\nVALUES\n  ('{{ $json.order_id }}', '{{ $json.name }}', '{{ $json.email }}', '{{ $json.telegram_username }}', {{ $json.price }}, '{{ $json.payment_status }}', '{{ $json.order_status }}', '{{ $json.invite_code }}', '{{ $json.created_at }}', {{ $json.approved_at ? \"'\" + $json.approved_at + \"'\" : 'NULL' }}, '')\nON CONFLICT (order_id) DO UPDATE SET\n  payment_status = EXCLUDED.payment_status,\n  order_status   = EXCLUDED.order_status,\n  invite_code    = COALESCE(EXCLUDED.invite_code, core.orders.invite_code),\n  approved_at    = EXCLUDED.approved_at;"
      },
      "credentials": {
        "postgres": {
          "id": "10",
          "name": "PostgreSQL - SalesChannel"
        }
      }
    },
    {
      "id": "node-if-status-email",
      "name": "Verificar Status para Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1400, 200],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-status-email",
              "leftValue": "={{ $json.payment_status }}",
              "rightValue": "aprovado",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-email-buyer",
      "name": "Email Comprador - Acesso VIP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1650, 100],
      "parameters": {
        "fromEmail": "COLE_SEU_EMAIL_AQUI@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "✅ Acesso Liberado — Vídeos SellingVideos VIP",
        "emailType": "html",
        "message": "=<div style=\"font-family:Inter,Arial,sans-serif;max-width:600px;margin:0 auto;background:#f4f4f8;padding:0\">\n  <div style=\"background:linear-gradient(135deg,#6c63ff,#a78bfa);padding:32px;text-align:center\">\n    <h1 style=\"color:white;margin:0;font-size:24px\">⚡ Seu Acesso está Pronto!</h1>\n  </div>\n  <div style=\"background:white;padding:32px\">\n    <p style=\"font-size:16px;color:#333\">Olá <strong>{{ $json.name }}</strong>!</p>\n    <p style=\"color:#555\">Seu pagamento foi confirmado. Para liberar sua entrada automaticamente no canal VIP, você deve clicar no botão abaixo e enviar a mensagem de início para o nosso bot.</p>\n    \n    <div style=\"text-align:center;margin:32px 0\">\n      <a href=\"https://t.me/divulgaVovo_bot?start={{ $json.invite_code }}\" style=\"background:#6c63ff;color:white;padding:16px 32px;text-decoration:none;border-radius:10px;display:inline-block;font-weight:bold;font-size:16px\">👉 Liberar Meu Acesso no Telegram</a>\n    </div>\n\n    <p style=\"color:#555;font-size:14px;text-align:center\">Seu código exclusivo: <strong>{{ $json.invite_code }}</strong></p>\n\n    <div style=\"background:#fff8e1;border-left:4px solid #f59e0b;padding:12px 16px;border-radius:4px;margin-top:20px\">\n      <strong>⚠️ Importante:</strong> O link gerado pelo bot funcionará apenas uma vez e expirará em 5 minutos. Use-o assim que receber.\n    </div>\n    \n    <hr style=\"border:none;border-top:1px solid #eee;margin:24px 0\">\n    <p style=\"font-size:12px;color:#999\">SellingVideos — Vídeos que vendem.</p>\n  </div>\n</div>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "3",
          "name": "Gmail SMTP - SalesChannel"
        }
      }
    },
    {
      "id": "node-email-pending",
      "name": "Email Comprador - Pedido Recebido",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1650, 300],
      "parameters": {
        "fromEmail": "COLE_SEU_EMAIL_AQUI@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "⏳ Recebemos seu pedido — SellingVideos",
        "emailType": "html",
        "message": "=<div style=\"font-family:Inter,Arial,sans-serif;max-width:600px;margin:0 auto;background:#f4f4f8;padding:0\">\n  <div style=\"background:#6c63ff;padding:32px;text-align:center\">\n    <h1 style=\"color:white;margin:0;font-size:24px\">🛒 Pedido Recebido!</h1>\n  </div>\n  <div style=\"background:white;padding:32px\">\n    <p style=\"font-size:16px;color:#333\">Olá <strong>{{ $json.name }}</strong>!</p>\n    <p style=\"color:#555\">Estamos aguardando a confirmação do pagamento pelo seu banco. Assim que for aprovado, enviaremos um novo e-mail com o seu código de acesso exclusivo.</p>\n    <p style=\"color:#555\">Isso costuma levar apenas alguns minutos (para Pix e Cartão) ou até 48h (para Boleto).</p>\n    \n    <hr style=\"border:none;border-top:1px solid #eee;margin:24px 0\">\n    <p style=\"font-size:12px;color:#999\">SellingVideos — Vídeos que vendem.</p>\n  </div>\n</div>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "3",
          "name": "Gmail SMTP - SalesChannel"
        }
      }
    },
    {
      "id": "node-email-admin",
      "name": "Email Admin - Relatório",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1620, 200],
      "parameters": {
        "fromEmail": "COLE_SEU_EMAIL_AQUI@gmail.com",
        "toEmail": "admin@saleschannel.com.br",
        "subject": "=🛒 Status Venda — {{ $json.payment_status.toUpperCase() }} #{{ $json.order_id }}",
        "emailType": "text",
        "message": "=Venda atualizada!\n\nOrder ID: {{ $json.order_id }}\nName: {{ $json.name }}\nE-mail: {{ $json.email }}\nInvite Code: {{ $json.invite_code || 'N/A' }}\nPrice: R${{ $json.price }}\nStatus: {{ $json.payment_status }}\n\nO cliente já foi notificado.",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "3",
          "name": "Gmail SMTP - SalesChannel"
        }
      }
    },
    {
      "id": "node-code-rejected",
      "name": "Tratar Status Recusado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 420],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payment = $input.first().json;\nconst statusMap = {\n  rejected: 'recusado',\n  cancelled: 'recusado',\n  refunded: 'estornado',\n  charged_back: 'estornado'\n};\nconst payer = payment.payer || {};\n\nreturn [{\n  json: {\n    order_id: payment.id?.toString() || '',\n    email: payer.email || '',\n    payment_status: statusMap[payment.status] || payment.status,\n    order_status: 'rejeitado'\n  }\n}];"
      }
    },
    {
      "id": "node-pg-update-rejected",
      "name": "Atualizar Status - Recusado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1180, 420],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.orders\n  (order_id, email, payment_status, order_status, created_at)\nVALUES\n  ('{{ $json.order_id }}', '{{ $json.email }}', '{{ $json.payment_status }}', '{{ $json.order_status }}', NOW())\nON CONFLICT (order_id) DO UPDATE SET\n  payment_status = EXCLUDED.payment_status,\n  order_status   = EXCLUDED.order_status;"
      },
      "credentials": {
        "postgres": {
          "id": "10",
          "name": "PostgreSQL - SalesChannel"
        }
      }
    }
  ],
  "connections": {
    "Receber IPN Mercado Pago": { "main": [[{ "node": "Filtrar por Pagamento", "type": "main", "index": 0 }]] },
    "Filtrar por Pagamento": { "main": [[{ "node": "Consultar Pagamento MP", "type": "main", "index": 0 }]] },
    "Consultar Pagamento MP": { "main": [[{ "node": "Detectar Status Pagamento", "type": "main", "index": 0 }]] },
    "Detectar Status Pagamento": {
      "main": [
        [{ "node": "Montar Objeto do Pedido", "type": "main", "index": 0 }],
        [{ "node": "Montar Objeto do Pedido", "type": "main", "index": 0 }],
        [{ "node": "Tratar Status Recusado", "type": "main", "index": 0 }]
      ]
    },
    "Montar Objeto do Pedido": { "main": [[{ "node": "Gravar Pedido no PostgreSQL", "type": "main", "index": 0 }]] },
    "Gravar Pedido no PostgreSQL": { "main": [[{ "node": "Verificar Status para Email", "type": "main", "index": 0 }]] },
    "Verificar Status para Email": {
      "main": [
        [{ "node": "Email Comprador - Acesso VIP", "type": "main", "index": 0 }],
        [{ "node": "Email Comprador - Pedido Recebido", "type": "main", "index": 0 }]
      ]
    },
    "Email Comprador - Acesso VIP": { "main": [[{ "node": "Email Admin - Relatório", "type": "main", "index": 0 }]] },
    "Email Comprador - Pedido Recebido": { "main": [[{ "node": "Email Admin - Relatório", "type": "main", "index": 0 }]] },
    "Tratar Status Recusado": { "main": [[{ "node": "Atualizar Status - Recusado", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["sellingvideos"]
}