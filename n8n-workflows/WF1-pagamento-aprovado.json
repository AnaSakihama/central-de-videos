        "jsCode": "const raw = $json || {};\nconst body = raw.body || raw;\nconst headers = raw.headers || {};\nconst eventType = body?.type || body?.topic || '';\nlet resourceId = '';\nif (body?.data?.id) {\n  resourceId = String(body.data.id);\n} else if (body?.id) {\n  resourceId = String(body.id);\n} else if (body?.resource && typeof body.resource === 'string') {\n  const parts = body.resource.split('/');\n  resourceId = parts[parts.length - 1];\n}\nreturn [{ json: { body, headers, event_type: eventType, resource_id: resourceId, received_at: new Date().toISOString() } }];"
      },
