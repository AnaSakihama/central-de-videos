    {
      "parameters": {
        "jsCode": "const payment = $input.first().json;\nconst meta = payment.metadata || {};\nconst payer = payment.payer || {};\n\nconst name = payer.first_name\n  ? `${payer.first_name} ${payer.last_name || ''}`.trim()\n  : (meta.name || meta.nome || 'Cliente');\n\nconst status = payment.status || 'pending';\nconst isApproved = status === 'approved';\n\n// Busca o e-mail em múltiplos locais possíveis para evitar perdas\nconst email = meta.email || payer.email || payment.payer?.email || '';\n\nlet inviteCode = null;\nif (isApproved) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  inviteCode = 'SV-';\n  for (let i = 0; i < 6; i++) {\n    inviteCode += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n}\n\nreturn [{\n  json: {\n    order_id: payment.id?.toString() || String(Date.now()),\n    payment_id: payment.id?.toString() || '',\n    external_reference: payment.external_reference || meta.external_reference || '',\n    name,\n    email: email,\n    telegram_username: meta.telegram_username || '',\n    price: Number(payment.transaction_amount || 0),\n    currency: payment.currency_id || 'BRL',\n    payment_status: isApproved ? 'aprovado' : 'pendente',\n    payment_status_raw: status,\n    order_status: isApproved ? 'novo' : 'aguardando_pagamento',\n    payment_method: payment.payment_method_id || '',\n    payment_type: payment.payment_type_id || '',\n    invite_code: inviteCode,\n    created_at: payment.date_created || new Date().toISOString(),\n    approved_at: isApproved ? (payment.date_approved || new Date().toISOString()) : null,\n    log_email: ''\n  }\n}];"
      },
