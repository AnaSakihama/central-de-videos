    {
      "parameters": {
        "jsCode": "const payment = $input.first().json;\nconst meta = payment.metadata || {};\nconst payer = payment.payer || {};\nconst name = payer.first_name ? `${payer.first_name} ${payer.last_name || ''}`.trim() : (meta.name || 'Cliente');\nconst status = payment.status || 'pending';\nconst isApproved = status === 'approved';\n\n// Captura ultra-robusta de e-mail\nconst email = (\n  meta.email || \n  payer.email || \n  (payment.additional_info && payment.additional_info.payer && payment.additional_info.payer.email) || \n  ''\n).toString().trim();\n\nlet inviteCode = null;\nif (isApproved) {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  inviteCode = 'SV-';\n  for (let i = 0; i < 6; i++) { inviteCode += chars.charAt(Math.floor(Math.random() * chars.length)); }\n}\nreturn [{ json: { order_id: payment.id?.toString(), payment_id: payment.id?.toString(), name: name.toString(), email, price: Number(payment.transaction_amount || 0), payment_status: isApproved ? 'aprovado' : 'pendente', order_status: 'novo', invite_code: inviteCode, created_at: payment.date_created, approved_at: isApproved ? payment.date_approved : null } }];"
      },
      "id": "b41263cc-4aaa-4a67-9715-8f7fd51f2953",
      "name": "Montar Objeto do Pedido",
