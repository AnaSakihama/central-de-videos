    {
      "parameters": {
        "jsCode": "const payment = $input.first().json;\nconst payer = payment.payer || {};\n\nconst statusMap = {\n  rejected: 'recusado',\n  cancelled: 'recusado',\n  refunded: 'estornado',\n  charged_back: 'estornado'\n};\n\nconst orderStatusMap = {\n  rejected: 'rejeitado',\n  cancelled: 'rejeitado',\n  refunded: 'estornado',\n  charged_back: 'estornado'\n};\n\nreturn [{\n  json: {\n    order_id: payment.id?.toString() || '',\n    payment_id: payment.id?.toString() || '',\n    name: payer.first_name ? `${payer.first_name} ${payer.last_name || ''}`.trim() : '',\n    email: payer.email || '',\n    price: Number(payment.transaction_amount || 0),\n    payment_status: statusMap[payment.status] || payment.status || 'recusado',\n    payment_status_raw: payment.status || '',\n    order_status: orderStatusMap[payment.status] || 'rejeitado',\n    invite_code: null\n  }\n}];"
      },
